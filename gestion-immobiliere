<!doctype html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Loyers"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="theme-color" content="#1b2f4b"><link rel="apple-touch-icon" href="data:image/png;base64,"><title>Suivi des loyers et réparations</title>
<style>
:root{--bg:#f4f6f9;--card:#fff;--tx:#1b2430;--mut:#6b7280;--ln:#d9dee6;--pri:#1b2f4b;--on:#fff;--ok:#d9f2e1;--part:#fdebc8;--late:#fbdcdc;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#12161c;--card:#1b222b;--tx:#e6e9ee;--mut:#9aa4b2;--ln:#2e3844;--pri:#7fa3d6;--on:#10161d;--ok:#1d4a2e;--part:#5a4519;--late:#5a2323}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#12161c;--card:#1b222b;--tx:#e6e9ee;--mut:#9aa4b2;--ln:#2e3844;--pri:#7fa3d6;--on:#10161d;--ok:#1d4a2e;--part:#5a4519;--late:#5a2323}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:var(--pri);color:var(--on);padding:12px 14px}
h1{margin:0;font-size:18px}h3{margin:14px 0 6px}
nav{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.tab{background:transparent;color:inherit;border:1px solid currentColor;border-radius:999px;padding:6px 14px;font:inherit;opacity:.8;cursor:pointer}
.tab.on{background:var(--on);color:var(--pri);opacity:1;font-weight:600}
main{max-width:1250px;margin:0 auto;padding:12px}
.card{background:var(--card);border:1px solid var(--ln);border-radius:10px;padding:12px;margin:0 0 10px}
.fm{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;align-items:end;margin-top:8px}
input,select,textarea{font:inherit;font-size:16px;padding:7px 8px;border:1px solid var(--ln);border-radius:7px;background:var(--bg);color:var(--tx);width:100%}
label{display:grid;gap:3px;font-size:12px;color:var(--mut)}
.b{font:inherit;padding:7px 12px;border-radius:7px;border:1px solid var(--ln);background:var(--card);color:var(--tx);cursor:pointer;text-decoration:none;display:inline-block}
.b.p{background:var(--pri);color:var(--on);border-color:var(--pri)}
.bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:8px 0}
.mut,small{color:var(--mut)}
.sc{overflow-x:auto}
table.rent{border-collapse:collapse;font-size:13px;min-width:1150px;background:var(--card)}
.rent th,.rent td{border:1px solid var(--ln);padding:4px 5px;text-align:right;white-space:nowrap}
.rent .l{text-align:left}
.rent input{width:72px;padding:4px;font-size:13px;text-align:right}
.pi.g2{background:var(--ok)}.pi.g1{background:var(--part)}.pi.g0{background:var(--late)}
.late{color:#c0392b;font-weight:600}.ok{color:#1e8449}
.tag{border:1px solid var(--ln);border-radius:999px;padding:1px 9px;font-size:12px}.tag.u{background:var(--late)}
.rh{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dn{border-left:4px solid #1e8449}
.dd{background:var(--bg);border-radius:7px;padding:8px;margin-top:6px}
summary{cursor:pointer}textarea{margin-top:8px;min-height:60px}
#ov{position:fixed;inset:0;background:rgba(0,0,0,.55);overflow:auto;padding:max(12px,env(safe-area-inset-top,0px)) 12px 12px;z-index:9}
.mod{background:var(--card);max-width:720px;margin:0 auto;padding:16px;border-radius:12px}
#sheet{background:#fff;color:#000;padding:14px;border:1px solid #ccc}
.sh{width:100%;border-collapse:collapse;margin-bottom:12px}.sh th,.sh td{border:1px solid #444;padding:7px;text-align:left;vertical-align:top}.sh th{width:34%;background:#eee}
@media print{body>*:not(#ov){display:none!important}#ov{position:static;background:none;padding:0}.mod{padding:0;max-width:none}.np{display:none!important}#sheet{border:0}}
</style></head>
<body>
<header><h1>Suivi des loyers et réparations</h1>
<nav><button class="tab" data-a="tab" data-t="bld">Bâtisses</button><button class="tab" data-a="tab" data-t="rent">Loyers</button><button class="tab" data-a="tab" data-t="log">Logements</button><button class="tab" data-a="tab" data-t="ten">Locataires</button><button class="tab" data-a="tab" data-t="rep">Réparations</button><button class="tab" data-a="tab" data-t="dep">Dépenses</button><button class="tab" data-a="tab" data-t="pro">Responsables</button><button class="tab" data-a="tab" data-t="rap">Rapport</button><button class="tab" data-a="tab" data-t="bak">Sauvegarde</button></nav><select id="bf" hidden style="margin-top:8px;width:auto;max-width:100%"></select></header>
<main id="v"></main>
<div id="ov" hidden><div class="mod" id="mod"></div></div>
<script>
const LOC={n:'Steve Dufresne',t:'450 808 9363',e:'Stevedufresne1@gmail.com'};
const MO=['Janv','Févr','Mars','Avr','Mai','Juin','Juil','Août','Sept','Oct','Nov','Déc'];
const SHCSS='body{font:14px system-ui,sans-serif;margin:24px}.sh{width:100%;border-collapse:collapse;margin-bottom:12px}.sh th,.sh td{border:1px solid #444;padding:7px;text-align:left;vertical-align:top}.sh th{width:34%;background:#eee}';
let S={blds:[],exps:[],taxes:[],taxg:[],pros:[],units:[],tenants:[],pay:{},repairs:[]},tab='rent',yr=new Date().getFullYear(),mo=new Date().getMonth(),fa='',fs='all',ref=null,tm;
const $=s=>document.querySelector(s),$$=n=>Number(n)||0;
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9);
const money=n=>$$(n).toLocaleString('fr-CA',{style:'currency',currency:'CAD'});
const today=()=>new Date().toISOString().slice(0,10);
const get=id=>S.repairs.find(r=>r.id===id);
const wk=r=>r.done?(r.done.work||(r.done.hours?[{who:r.done.by,hours:r.done.hours,rate:r.done.rate}]:[])):[];
const labor=r=>wk(r).reduce((q,w)=>q+$$(w.hours)*$$(w.rate),0);
const hrsOf=r=>wk(r).reduce((q,w)=>q+$$(w.hours),0);
const otherC=r=>r.done?r.done.costs.reduce((s,c)=>s+c.a,0):0;
const costOf=r=>labor(r)+(r.done?$$(r.done.mat):0)+otherC(r);
const key=(t,m)=>t.id+'_'+yr+String(m+1).padStart(2,'0');
function dmo(){const y=new Date();return yr<y.getFullYear()?12:yr>y.getFullYear()?0:y.getMonth()+1}

async function init(){
  try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}
  try{const raw=localStorage.getItem('suivi');if(raw){S=Object.assign(S,JSON.parse(raw));migrate()}}catch(e){}
  if(!S.units.length)tab=S.blds.length?'log':'bld';
  render();
  try{
    const [db,user]=await Promise.all([claude.use('db'),claude.use('user')]);
    if(db&&user){const id=await user.id();ref=db.collection('data/users/'+id).doc('state');
      const s=await ref.get();
      if(s.exists){S=Object.assign({units:[],tenants:[],pay:{},repairs:[]},JSON.parse(JSON.stringify(s.data())));migrate();if(S.units.length&&(tab==='log'||tab==='bld'))tab='rent';render()}
      else if(S.tenants.length||S.repairs.length)ref.set(S).catch(()=>{});}
  }catch(e){}
}
function sv(t){let d=$('#sv');if(!d){d=document.createElement('div');d.id='sv';d.style.cssText='background:#c0392b;color:#fff;padding:6px 12px;font-size:13px';$('#v').before(d)}d.textContent=t;d.hidden=!t}
function save(){clearTimeout(tm);tm=setTimeout(()=>{try{localStorage.setItem('suivi',JSON.stringify(S))}catch(e){}try{if(ref)ref.set(S).then(()=>sv(''),e=>sv('⚠ Sauvegarde dans votre compte impossible : '+((e&&e.message)||e)))}catch(e){sv('⚠ Sauvegarde dans votre compte impossible : '+e.message)}},400)}

function syncAddr(){for(const r of S.repairs){let u=S.units.find(x=>x.id===r.unit)||(!r.unit&&S.units.find(x=>x.name===r.addr));if(u){r.unit=u.id;r.addr=u.name}}}
function render(){
  syncAddr();migrateB();fillBf();
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.t===tab));
  $('#v').innerHTML=({rent:vRent,rep:vRep,bak:vBak,ten:vTen,log:vLog,rap:vRap,pro:vPros,dep:vDep,bld:vBld}[tab]||vRent)();
  if(tab==='rent'&&S.units.length)vm()==='m'?mstat():tots();
}
const mob=()=>window.innerWidth<700;
const MOL=['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
function vBak(){return `<div class="card"><b>Copie de sauvegarde</b><p class="mut">Vos données sont enregistrées automatiquement (dans votre compte Claude, ou dans ce navigateur si vous utilisez la version autonome). Pour garder aussi une copie dans iCloud, enregistrez le fichier dans l’app Fichiers, sous iCloud Drive.</p><button class="b p" data-a="bak">Enregistrer une copie</button></div><div class="card"><b>Restaurer une copie</b><p class="mut">Remplace toutes les données actuelles par celles du fichier choisi.</p><input id="rs" type="file" accept=".json,application/json"><p id="rm" class="late"></p></div>`}
function vRep(){
  const A=addrs();
  let h=`<details class="card" ${S.repairs.length?'':'open'}><summary><b>+ Nouvelle réparation</b></summary><div class="fm"><select id="ra"><option value="">Choisir le logement…</option>${S.units.map(u=>`<option value="${u.id}">${esc(u.name)}</option>`).join('')}</select>${S.units.length?'':'<small>Ajoutez d’abord un logement (onglet Logements).</small>'}<input id="rd" placeholder="Réparation à faire"><select id="rp"><option>Normale</option><option>Urgente</option><option>Faible</option></select>${proPick([])}<input id="rdt" type="date" value="${today()}"><button class="b p" data-a="addR">Créer et ouvrir la fiche</button></div></details>`;
  h+=`<div class="bar"><select id="fa" style="width:auto"><option value="">Toutes les adresses</option>${A.map(a=>`<option value="${esc(a)}" ${a===fa?'selected':''}>${esc(a)}</option>`).join('')}</select><select id="fs" style="width:auto">${[['all','Toutes'],['open','Ouvertes'],['done','Terminées']].map(o=>`<option value="${o[0]}" ${o[0]===fs?'selected':''}>${o[1]}</option>`).join('')}</select></div>`;
  const list=S.repairs.filter(r=>(!bf||bOfR(r)===bf)&&(!fa||r.addr===fa)&&(fs==='all'||(fs==='open')===(r.status!=='done'))),g={};
  list.forEach(r=>{const a=r.addr||'(sans adresse)';(g[a]=g[a]||[]).push(r)});
  for(const a in g){
    const rs=g[a],cost=rs.reduce((s,r)=>s+costOf(r),0),hrs=rs.reduce((s,r)=>s+hrsOf(r),0),op=rs.filter(r=>r.status!=='done').length;
    h+=`<h3>${esc(a)} <small>· ${op} ouverte(s) · dépenses ${money(cost)} · ${hrs} h</small></h3>`+rs.map(card).join('');
  }
  return list.length?h:h+'<div class="card mut">Aucune réparation à afficher.</div>';
}
function card(r){
  const d=r.done;
  return `<div class="card ${r.status==='done'?'dn':''}"><div class="rh"><b>n° ${r.n} · ${esc(r.desc)}</b><span class="tag ${r.prio==='Urgente'?'u':''}">${esc(r.prio)}</span><span class="tag">${r.status==='done'?'Terminée':'Ouverte'}</span></div><div class="mut">Prévue : ${esc(r.date||'—')} · Responsables : ${esc(names(r)||'—')}</div>`
  +(d?`<div class="dd">${r.status==='done'?'Fermée':'En cours'} le ${esc(d.date)} par <b>${esc(d.by)}</b> ${esc(d.phone)} · ${hrsOf(r)} h · Main-d’œuvre ${money(labor(r))}${wk(r).length?' ('+wk(r).map(w=>esc(w.who)+' '+w.hours+' h × '+money(w.rate)).join(' ; ')+')':''} · Matériaux ${money(d.mat)} · Total : <b>${money(costOf(r))}</b>${d.costs.length?'<br>Autres : '+d.costs.map(c=>esc(c.d)+' '+money(c.a)).join(' · '):''}${d.note?'<br>'+esc(d.note):''}</div>`:'')
  +`<div class="bar"><button class="b" data-a="sheet" data-id="${r.id}">Fiche</button><button class="b" data-a="edit" data-id="${r.id}">Modifier</button><button class="b ${r.status==='done'?'':'p'}" data-a="close" data-id="${r.id}">${r.status==='done'?'Modifier l’exécution':'Renseigner / fermer'}</button>${r.status==='done'?`<button class="b" data-a="reopen" data-id="${r.id}">Rouvrir</button>`:''}<button class="b" data-a="delR" data-id="${r.id}">Supprimer</button></div></div>`;
}
function sheetHTML(r){
  const t=tenOf(r.addr);
  const row=(a,b,s)=>`<tr><th>${a}</th><td${s?` style="${s}"`:''}>${b}</td></tr>`;
  return `<h2>Fiche de réparation n° ${r.n}</h2><table class="sh">${row('Adresse / logement',esc(r.addr))}${row('Locataire',t?esc(t.name+' '+t.phone):'')}${row('Travaux à effectuer',esc(r.desc))}${row('Priorité',esc(r.prio))}${row('Date prévue',esc(r.date))}${row('Assigné à',people(r).map(p=>esc(p.name+' '+p.phone+' '+p.email)).join('<br>')||'—')}${row('Locateur',`${LOC.n} · ${LOC.t} · ${LOC.e}`)}</table><h3>À remplir par l’exécutant</h3><table class="sh">${row('Date des travaux','&nbsp;')}${row('Travailleur(s) : nom, heures, taux ($/h)','','height:70px')}${row('Matériaux ($)','&nbsp;')}${row('Autres dépenses ($)','','height:50px')}${row('Commentaires','','height:70px')}${row('Nom et signature','','height:50px')}</table>`;
}
async function saveFile(n,data){let d=null;try{d=await claude.use('downloads')}catch(e){}
  if(d){await d.save({filename:n,data});return}
  const u=URL.createObjectURL(new Blob([data]));const a=document.createElement('a');a.href=u;a.download=n;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),5000)}
function ov(h){$('#mod').innerHTML=h;$('#ov').hidden=false}
function openSheet(id){
  const r=get(id);
  const body=`Fiche de réparation n° ${r.n}\nAdresse : ${r.addr}\nTravaux : ${r.desc}\nPriorité : ${r.prio}\nDate prévue : ${r.date}\n\nMerci de me confirmer la date des travaux et de m’indiquer à la fin le temps passé et les dépenses (avec factures).\n\n${LOC.n}\n${LOC.t}`;
  const href='mailto:'+people(r).map(p=>p.email).filter(Boolean).map(encodeURIComponent).join(',')+'?subject='+encodeURIComponent('Fiche de réparation n° '+r.n+' – '+r.addr)+'&body='+encodeURIComponent(body);
  ov(`<div id="sheet">${sheetHTML(r)}</div><div class="bar np"><button class="b p" data-a="pr">Imprimer</button><a class="b p" target="_blank" rel="noopener" href="${href}">Envoyer par courriel</a><button class="b" data-a="dl" data-id="${id}">Télécharger</button><button class="b" data-a="x">Fermer</button></div>`);
}
let vw='',lastRap='',lastDoc={};
const vm=()=>vw||(mob()?'m':'y');
const ymk=(y,m)=>y+'-'+String(m+1).padStart(2,'0');
const rentFor=(u,y,m)=>{let a=0;const k=ymk(y,m);for(const r of u.rents)if(r.from<=k)a=r.amt;return a};
const occ=(u,y,m)=>{const k=ymk(y,m);return S.tenants.find(t=>t.unit===u.id&&(t.start||'0').slice(0,7)<=k&&k<=(t.left?(t.end||t.start||'0'):(t.end||'9999')).slice(0,7))};
const due=(u,y,m)=>occ(u,y,m)?rentFor(u,y,m):0;
const paid=(u,y,m)=>$$(S.pay[u.id+'_'+y+String(m+1).padStart(2,'0')]);
const dmf=y=>{const n=new Date();return y<n.getFullYear()?12:y>n.getFullYear()?0:n.getMonth()+1};
function bal(u,y){let b=0;for(let m=0;m<12;m++)b+=(m<dmf(y)?due(u,y,m):0)-paid(u,y,m);return b}
const nowOcc=u=>{const n=new Date();return occ(u,n.getFullYear(),n.getMonth())};
const curRent=u=>{const n=new Date();return rentFor(u,n.getFullYear(),n.getMonth())};
const tenOf=a=>{const u=S.units.find(x=>x.name===a);return u&&nowOcc(u)};
function migrate(){
  S.units=S.units||[];migratePros();
  for(const t of S.tenants){
    if(t.unit===undefined){
      const u={id:uid(),name:t.addr||t.name,rents:[{from:'',amt:$$(t.rent)}]};S.units.push(u);
      for(const k of Object.keys(S.pay))if(k.startsWith(t.id+'_')){S.pay[u.id+k.slice(t.id.length)]=S.pay[k];delete S.pay[k]}
      t.unit=u.id;delete t.addr;delete t.rent;
    }
    t.phone=t.phone||'';t.email=t.email||'';t.notes=t.notes||'';t.start=t.start||'';t.end=t.end||'';t.left=!!t.left;
  }
}
function addrs(){return [...new Set([...S.units.map(u=>u.name),...S.repairs.map(r=>r.addr)].filter(Boolean))]}

function vRent(){
  if(!S.units.length)return '<div class="card">Ajoutez d’abord vos logements dans l’onglet « Logements ».</div>';
  const Y=new Date().getFullYear(),late=uL().filter(u=>bal(u,Y)>0.005);
  let h=late.length?`<div class="card" style="border-left:4px solid #c0392b"><b class="late">En retard (année en cours)</b>${late.map(u=>{const t=nowOcc(u);return `<div>${esc(u.name)} · ${esc(t?t.name:'Vacant')} : <b>${money(bal(u,Y))}</b></div>`}).join('')}</div>`:'';
  const tl=S.taxes.filter(t=>!t.paid&&t.due&&t.due<today()&&(!bf||t.b===bf));
  if(tl.length)h=`<div class="card" style="border-left:4px solid #c0392b"><b class="late">Taxes en retard : ${tl.length} versement(s)</b> – voir l’onglet Dépenses</div>`+h;
  h+=`<div class="bar"><button class="b" data-a="vw">${vm()==='m'?'Vue annuelle':'Vue par mois'}</button></div>`;
  return h+(vm()==='m'?vMob():vYear());
}
function vYear(){
  let h=`<div class="bar"><button class="b" data-a="yr" data-d="-1">◀</button><strong>${yr}</strong><button class="b" data-a="yr" data-d="1">▶</button></div><div class="sc"><table class="rent"><thead><tr><th class="l">Logement</th><th>Loyer</th>${MO.map(m=>`<th>${m}</th>`).join('')}<th>Reçu</th><th>Solde</th></tr></thead><tbody>`;
  for(const u of uL()){
    const t=nowOcc(u);
    h+=`<tr><td class="l"><b>${esc(u.name)}</b><br><small>${esc(t?t.name:'Vacant')}</small></td><td>${money(curRent(u))}</td>`;
    for(let m=0;m<12;m++){const k=key(u,m),v=S.pay[k];h+=`<td><input type="number" step="0.01" min="0" class="pi" data-k="${k}" data-t="${u.id}" data-m="${m}" value="${v==null?'':v}"></td>`}
    h+=`<td id="rt-${u.id}"></td><td id="rb-${u.id}"></td></tr>`;
  }
  return h+`</tbody><tfoot><tr><td class="l" colspan="2"><b>Total reçu</b></td>${MO.map((_,m)=>`<td id="ct-${m}"></td>`).join('')}<td id="gt"></td><td></td></tr></tfoot></table></div>`;
}
function tots(){
  const dm=dmo(),ct=Array(12).fill(0);let g=0;
  for(const u of uL()){
    let s=0;for(let m=0;m<12;m++){const v=paid(u,yr,m);s+=v;ct[m]+=v}
    g+=s;$('#rt-'+u.id).textContent=money(s);
    const b=bal(u,yr),e=$('#rb-'+u.id);
    e.textContent=b>0.005?money(b)+' dû':b<-0.005?money(-b)+' crédit':'À jour';e.className=b>0.005?'late':'ok';
  }
  ct.forEach((v,m)=>$('#ct-'+m).textContent=v?money(v):'');$('#gt').textContent=money(g);
  document.querySelectorAll('.pi').forEach(i=>{
    const u=S.units.find(x=>x.id===i.dataset.t),m=+i.dataset.m,v=$$(i.value),d=due(u,yr,m);
    i.className='pi'+(v>0&&v>=d?' g2':v>0?' g1':d>0&&m<dm?' g0':'');
  });
}
function vMob(){
  let h=`<div class="bar"><button class="b" data-a="mo" data-d="-1">◀</button><strong>${MOL[mo]} ${yr}</strong><button class="b" data-a="mo" data-d="1">▶</button></div>`;
  for(const u of uL()){
    const k=key(u,mo),v=S.pay[k],t=occ(u,yr,mo),d=rentFor(u,yr,mo);
    h+=`<div class="card"><div class="rh"><b>${esc(u.name)}</b><small>${esc(t?t.name:'Vacant')}</small></div><div class="mut">Loyer : ${money(d)}</div><div class="fm"><input type="number" inputmode="decimal" step="0.01" min="0" class="pm" data-k="${k}" placeholder="Montant reçu ($)" value="${v==null?'':v}"><button class="b" data-a="full" data-k="${k}" data-r="${d}">Payé en entier</button>${t?`<button class="b" data-a="rcu" data-id="${u.id}">Reçu de loyer</button>`:''}</div><div id="ms-${u.id}"></div></div>`;
  }
