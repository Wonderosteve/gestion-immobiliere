function taxSec(bn,sel,td){
  const gs=S.taxg.filter(g=>(!bf||g.b===bf)&&String(g.year)===String(yr));
  let h=`<div class="card"><b>Comptes de taxes (municipale et scolaire)</b><div class="fm"><select id="kb">${bopt(sel)}</select><select id="kt"><option>Municipale</option><option>Scolaire</option></select><input id="ky" type="number" value="${yr}" placeholder="Année"><input id="ka" type="number" step="0.01" min="0" inputmode="decimal" placeholder="Montant total ($)"><label>Nombre de versements<select id="kn">${[1,2,3,4,6,12].map(n=>`<option ${n===2?'selected':''}>${n}</option>`).join('')}</select></label><label>Intervalle (mois)<select id="ki">${[1,2,3,4,6].map(n=>`<option ${n===3?'selected':''}>${n}</option>`).join('')}</select></label><label>1re échéance<input id="kd" type="date"></label><button class="b p" data-a="addTG">Créer les versements</button></div></div>`;
  for(const g of gs){
    const rs=S.taxes.filter(t=>t.g===g.id).sort((a,b)=>a.due<b.due?-1:1),pd=rs.filter(t=>t.paid).reduce((s,t)=>s+t.amt,0),sum=rs.reduce((s,t)=>s+t.amt,0);
    h+=`<div class="card"><div class="rh" style="justify-content:space-between"><b>${esc(bn(g.b))} · Taxe ${esc(g.type.toLowerCase())} ${g.year}</b><span class="mut">Total <input data-tg="${g.id}" type="number" step="0.01" value="${g.total}" style="width:110px;display:inline-block"></span></div><div class="mut">Payé ${money(pd)} · Solde ${money(g.total-pd)}${Math.abs(sum-g.total)>0.005?` · <span class="late">Les versements totalisent ${money(sum)}</span>`:''}</div>`
    +rs.map((t,i)=>`<div class="rh" style="border-top:1px solid var(--ln);padding:6px 0"><b>${i+1}/${rs.length}</b><input data-ti="${t.id}" data-f="due" type="date" value="${t.due}" style="width:auto"><input data-ti="${t.id}" data-f="amt" type="number" step="0.01" value="${t.amt}" style="width:110px">${t.paid?`<span class="ok">Payée le</span><input data-ti="${t.id}" data-f="paid" type="date" value="${t.paid}" style="width:auto">`:`<b class="${t.due<td?'late':''}">${t.due<td?'En retard':'À payer'}</b>`}<button class="b" data-a="${t.paid?'unpay':'pay'}" data-id="${t.id}">${t.paid?'Annuler':'Marquer payée'}</button><button class="b" data-a="delK" data-id="${t.id}">×</button></div>`).join('')
    +`<div class="bar"><button class="b" data-a="addV" data-id="${g.id}">+ Versement</button><button class="b" data-a="delTG" data-id="${g.id}">Supprimer le compte</button></div></div>`;
  }
  return h;
}
document.addEventListener('click',async e=>{
  const b=e.target.closest('[data-a]');if(!b)return;
  const a=b.dataset.a,id=b.dataset.id,v=i=>$('#'+i).value.trim();
  if(a==='tab'){tab=b.dataset.t;render();return}
  if(a==='mo'){mo+=+b.dataset.d;if(mo<0){mo=11;yr--}if(mo>11){mo=0;yr++}render();return}
  if(a==='full'){S.pay[b.dataset.k]=Number(b.dataset.r);save();render();return}
  if(a==='yr'){yr+=+b.dataset.d;render();return}
  if(['delT','delR','delU','delP','delB','delX','delK','delTG','left'].includes(a)&&!b.dataset.c){b.dataset.c=1;b.textContent='Confirmer ?';return}
  if(a==='addU')addU();
  else if(a==='delU'){S.units=S.units.filter(u=>u.id!==id);save();render()}
  else if(a==='delT'){S.tenants=S.tenants.filter(t=>t.id!==id);save();render()}
  else if(a==='addTn')addTn();
  else if(a==='left'){const t=S.tenants.find(x=>x.id===id);t.left=true;t.end=t.end||today();save();render()}
  else if(a==='qadd'){const g=p=>$('#'+p+'-'+id).value.trim();if(!g('qn')){$('#qn-'+id).focus();return}S.tenants.unshift({id:uid(),name:g('qn'),phone:g('qp'),email:g('qe'),unit:id,start:g('qs')||today(),end:'',notes:'',left:false});save();render()}
  else if(a==='addB'){const n=$('#bn').value.trim();if(!n)return;S.blds.push({id:uid(),name:n,addr:$('#ba').value.trim()});save();render()}
  else if(a==='delB'){if(S.units.some(u=>u.b===id)||S.exps.some(x=>x.b===id)||S.taxes.some(x=>x.b===id)){b.textContent='Encore utilisée';return}S.blds=S.blds.filter(x=>x.id!==id);save();render()}
  else if(a==='addTG'){const tot=$$($('#ka').value),n=+$('#kn').value,iv=+$('#ki').value,d=$('#kd').value,bb=$('#kb').value;if(!tot||!d||!bb){b.textContent='Montant total, bâtisse et 1re échéance requis';return}const g={id:uid(),b:bb,type:$('#kt').value,year:+$('#ky').value||yr,total:tot},each=Math.floor(tot/n*100)/100;S.taxg.push(g);for(let i=0;i<n;i++)S.taxes.push({id:uid(),g:g.id,b:bb,type:g.type,due:addMonths(d,i*iv),amt:i===n-1?Math.round((tot-each*(n-1))*100)/100:each,paid:''});save();render()}
  else if(a==='addV'){const g=S.taxg.find(x=>x.id===id),rs=S.taxes.filter(t=>t.g===id),sum=rs.reduce((q,t)=>q+t.amt,0),last=rs.map(t=>t.due).sort().pop();S.taxes.push({id:uid(),g:id,b:g.b,type:g.type,due:last?addMonths(last,3):today(),amt:Math.max(0,Math.round((g.total-sum)*100)/100),paid:''});save();render()}
  else if(a==='delTG'){S.taxes=S.taxes.filter(t=>t.g!==id);S.taxg=S.taxg.filter(g=>g.id!==id);save();render()}
  else if(a==='pay'||a==='unpay'){S.taxes.find(t=>t.id===id).paid=a==='pay'?today():'';save();render()}
  else if(a==='delK'){S.taxes=S.taxes.filter(t=>t.id!==id);save();render()}
  else if(a==='addX'){const am=$$($('#xa').value);if(!am||!$('#xb').value){b.textContent='Montant requis';return}S.exps.unshift({id:uid(),b:$('#xb').value,cat:$('#xc').value,desc:$('#xd').value.trim(),amt:am,date:$('#xt').value||today()});save();render()}
  else if(a==='delX'){S.exps=S.exps.filter(e=>e.id!==id);save();render()}
  else if(a==='addW')addWork();
  else if(a==='rmW'){b.closest('.wk').remove();calcTot()}
  else if(a==='addP')addP();
  else if(a==='delP'){S.pros=S.pros.filter(p=>p.id!==id);S.repairs.forEach(r=>r.pros=(r.pros||[]).filter(x=>x!==id));save();render()}
  else if(a==='edit')editForm(id);
  else if(a==='doEdit'){const r=get(id);if(!v('ed')){$('#ed').focus();return}Object.assign(r,{unit:$('#eu').value,desc:v('ed'),prio:$('#ep').value,pros:[...document.querySelectorAll('#ov .pk:checked')].map(x=>x.value),date:$('#edt').value});save();$('#ov').hidden=true;render()}
  else if(a==='reopen'){get(id).status='open';save();render()}
  else if(a==='raise')raise(id);
  else if(a==='rcu')receipt(id);
  else if(a==='vw'){vw=vm()==='m'?'y':'m';render()}
  else if(a==='rapdoc')openDoc(lastRap,null,'rapport-'+yr+'.html');
  else if(a==='dld'){try{await saveFile(lastDoc.fn,'<!doctype html><meta charset="utf-8"><style>'+SHCSS+'</style>'+lastDoc.h)}catch(x){b.textContent='Indisponible'}}
  else if(a==='addR'){
    if(!v('ra')){$('#ra').focus();return}
    if(!v('rd')){$('#rd').focus();return}
    const r={id:uid(),n:1+Math.max(0,...S.repairs.map(x=>x.n)),unit:v('ra'),addr:(S.units.find(u=>u.id===v('ra'))||{}).name||'',desc:v('rd'),prio:$('#rp').value,pros:[...document.querySelectorAll('#v .pk:checked')].map(x=>x.value),who:'',phone:'',email:'',date:v('rdt'),status:'open'};
    S.repairs.unshift(r);save();render();openSheet(r.id);
  }
  else if(a==='delR'){S.repairs=S.repairs.filter(r=>r.id!==id);save();render()}
  else if(a==='sheet')openSheet(id);
  else if(a==='close')closeForm(id);
  else if(a==='addC')addCost();
  else if(a==='x')$('#ov').hidden=true;
  else if(a==='bak'){try{await saveFile('sauvegarde-loyers-'+today()+'.json',JSON.stringify(S,null,1));b.textContent='Copie enregistrée ✓'}catch(x){b.textContent='Enregistrement annulé ou indisponible'}}
  else if(a==='pr'){try{window.print()}catch(x){b.textContent='Utilisez Télécharger'}}
  else if(a==='dl'){
    try{await saveFile('fiche-reparation-'+get(id).n+'.html','<!doctype html><meta charset="utf-8"><title>Fiche de réparation</title><style>'+SHCSS+'</style>'+sheetHTML(get(id)))}
    catch(x){b.textContent='Indisponible'}
  }
  else if(a==='doClose'){
        const r=get(id),costs=[...document.querySelectorAll('.cr')].map(d=>({d:d.querySelector('.cdsc').value.trim(),a:$$(d.querySelector('.camt').value)})).filter(c=>c.a||c.d);
    if(b.dataset.fin)r.status='done';const work=[...document.querySelectorAll('.wk')].map(d=>({who:d.querySelector('.wn').value.trim(),hours:$$(d.querySelector('.wh').value),rate:$$(d.querySelector('.wr').value)})).filter(w=>w.who||w.hours);r.done={by:work.map(w=>w.who).filter(Boolean).join(', '),phone:'',date:$('#cd').value,work,hours:work.reduce((q,w)=>q+w.hours,0),rate:0,mat:$$($('#cm').value),costs,note:v('cn')};
    save();$('#ov').hidden=true;render();
  }
});
document.addEventListener('change',e=>{
  const t=e.target;
  if(t.classList.contains('pm')){if(t.value==='')delete S.pay[t.dataset.k];else S.pay[t.dataset.k]=Number(t.value);save();mstat()}
  else if(t.classList.contains('pi')){if(t.value==='')delete S.pay[t.dataset.k];else S.pay[t.dataset.k]=Number(t.value);save();tots()}
  else if(t.dataset.ti){const x=S.taxes.find(q=>q.id===t.dataset.ti);x[t.dataset.f]=t.dataset.f==='amt'?$$(t.value):t.value;save();render()}
  else if(t.dataset.tg){S.taxg.find(q=>q.id===t.dataset.tg).total=$$(t.value);save();render()}
  else if(t.id==='bf'){bf=t.value;render()}
  else if(t.dataset.bd){const x=S.blds.find(q=>q.id===t.dataset.bd);x[t.dataset.f]=t.value;save()}
  else if(t.classList.contains('wn')){const p=S.pros.find(x=>x.name===t.value),r=t.closest('.wk').querySelector('.wr');if(p&&p.rate&&!r.value)r.value=p.rate;calcTot()}
  else if(t.dataset.p){const x=S.pros.find(q=>q.id===t.dataset.p);x[t.dataset.f]=t.dataset.f==='rate'?$$(t.value):t.value;save()}
  else if(t.dataset.u){S.units.find(q=>q.id===t.dataset.u)[t.dataset.f]=t.value;save()}
  else if(t.dataset.as){const x=S.tenants.find(q=>q.id===t.value);if(x){x.unit=t.dataset.as;x.left=false;x.start=x.start||today();save();render()}}
  else if(t.dataset.e){const x=S.tenants.find(q=>q.id===t.dataset.e);x[t.dataset.f]=t.value;save();if(t.tagName==='SELECT'||t.type==='date')render()}
  else if(t.id==='rs'){const f=t.files[0];if(!f)return;f.text().then(x=>{try{const o=JSON.parse(x);if(o&&Array.isArray(o.tenants)&&Array.isArray(o.repairs)){S={blds:o.blds||[],exps:o.exps||[],taxes:o.taxes||[],taxg:o.taxg||[],pros:o.pros||[],units:o.units||[],tenants:o.tenants,pay:o.pay||{},repairs:o.repairs};migrate();save();tab='rent';render()}else $('#rm').textContent='Fichier non valide.'}catch(e){$('#rm').textContent='Fichier non valide.'}})}
  else if(t.id==='fa'){fa=t.value;render()}
  else if(t.id==='fs'){fs=t.value;render()}
});
init();
</script></body></html>
